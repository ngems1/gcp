# Copy to terraform.tfvars and fill in.
project_id  = "your-project-id"
github_repo = "your-github-user/your-repo"

# Optional overrides (defaults shown)
# region            = "us-east1"
# zone              = "us-east1-b"
# main_branch       = "main"
# apply_environment = "infra"
# state_bucket      = ""   # default: <project_id>-tfstate
# wif_pool_id       = "github-task-manager" # keep separate from other repos' pools
